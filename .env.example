# muave-sapmcp — credentials & runtime config
#
# Secrets are referenced by NAME from systems.json and resolved from the
# environment at runtime. NEVER put secret values in systems.json.
# In production these are supplied via the MCP client's `env` block (.mcp.json),
# a process manager, or a secret manager.

# OAuth 2.0 client-credentials (client_id/secret from the Communication Arrangement)
EXAMPLE_OAUTH_CLIENT_ID=
EXAMPLE_OAUTH_CLIENT_SECRET=

# HTTP Basic (communication user)
QUAL_COMM_USER=
QUAL_COMM_PASSWORD=

# Private Cloud / on-prem communication user (system "PRIVATE")
PRIVATE_COMM_USER=
PRIVATE_COMM_PASSWORD=
# Corporate-CA trust: either point tls.caFile at a PEM file (as in the example),
# or supply the PEM inline here and reference it via tls.caEnvVar instead:
# PRIVATE_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Logging: trace | debug | info | warn | error (default: info). Logs go to stderr.
LOG_LEVEL=info

# Optional path overrides.
# Catalog cache default: a .muave-sapmcp/ dir NEXT TO your systems.json
# (predictable even when launched by GUI apps like Claude Desktop).
# Override with cacheDir in systems.json, or these env vars:
# MUAVE_SYSTEMS_FILE=./systems.json
# MUAVE_HOME=./.muave-sapmcp
# MUAVE_CACHE_DIR=./.muave-sapmcp
# MUAVE_ENV_FILE=./.env.local
