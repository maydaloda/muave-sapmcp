{
  "schemaVersion": 1,
  "defaultSystem": "EXAMPLE",
  "systems": [
    {
      "key": "EXAMPLE",
      "name": "Example S/4HANA Cloud (sandbox)",
      "baseUrl": "https://my123456-api.s4hana.cloud.sap",
      "sapClient": "100",
      "authType": "OAUTH2",
      "tokenUrl": "https://my123456-api.s4hana.cloud.sap/sap/bc/sec/oauth2/token?sap-client=100",
      "clientIdEnvVar": "EXAMPLE_OAUTH_CLIENT_ID",
      "clientSecretEnvVar": "EXAMPLE_OAUTH_CLIENT_SECRET",
      "tokenRefreshMarginSec": 60,
      "readOnly": true
    },
    {
      "key": "QUAL",
      "name": "Quality tenant (writes enabled, allowlisted)",
      "baseUrl": "https://my654321.s4hana.ondemand.com",
      "authType": "BASIC",
      "userEnvVar": "QUAL_COMM_USER",
      "passwordEnvVar": "QUAL_COMM_PASSWORD",
      "readOnly": false,
      "allowedEntities": ["A_BusinessPartner", "A_PurchaseRequisitionItem"]
    },
    {
      "key": "PRIVATE",
      "name": "S/4HANA Private Cloud / on-prem (corporate CA, comm user)",
      "baseUrl": "https://s4.corp.example.internal:44300",
      "sapClient": "100",
      "authType": "BASIC",
      "userEnvVar": "PRIVATE_COMM_USER",
      "passwordEnvVar": "PRIVATE_COMM_PASSWORD",
      "readOnly": true,
      "tls": {
        "caFile": "./corporate-ca.pem"
      }
    }
  ]
}
