# ── Auth ──────────────────────────────────────────────────────────────
# Public URL of this deployment (no trailing slash). On Vercel: https://<app>.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# 32+ random bytes; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Initial admin (used by `npm run seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────
# Neon/Postgres connection string. Leave UNSET locally to use embedded PGlite (web/.data/).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── SAP systems (same schema as systems.json, inline) ─────────────────
# MUAVE_SYSTEMS_JSON={"schemaVersion":1,"defaultSystem":"REQSYS","systems":[{"key":"REQSYS","baseUrl":"https://myXXXXXX-api.s4hana.cloud.sap","sapClient":"100","authType":"BASIC","userEnvVar":"S4_USER","passwordEnvVar":"S4_PASSWORD","readOnly":true}]}

# SAP credentials referenced by name from MUAVE_SYSTEMS_JSON
S4_USER=
S4_PASSWORD=
