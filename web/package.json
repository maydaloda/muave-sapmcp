{
  "name": "muave-sapmcp-web",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP deployment of muave-sapmcp: Streamable HTTP on Vercel with email+password auth and admin-managed group access.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/predeploy-migrate.mjs && next build",
    "start": "next start",
    "db:deploy": "node scripts/predeploy-migrate.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx scripts/seed.ts",
    "e2e": "tsx scripts/e2e-local.ts",
    "e2e:auth": "tsx scripts/e2e-auth.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "better-auth": "^1.5.0",
    "drizzle-orm": "^0.45.0",
    "mcp-handler": "^1.0.2",
    "muave-sapmcp": "^0.2.0",
    "next": "^15.3.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
